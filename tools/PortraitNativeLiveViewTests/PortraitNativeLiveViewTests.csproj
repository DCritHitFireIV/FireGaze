<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitNativeLiveView.cs') And Exists('../../src/FireGaze/PortraitPreview/PortraitNativeLiveNodeSource.cs')">$(DefineConstants);HAS_NATIVE_LIVE_VIEW</DefineConstants>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitNativeLiveController.cs')">$(DefineConstants);HAS_NATIVE_LIVE_CONTROLLER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPhotoTrace.cs" Link="PortraitPhotoTrace.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitNativeLive*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitCapture*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitLive*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPreviewSession.cs" Link="Production/PortraitPreviewSession.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitThumbnailSource.cs" Link="Production/PortraitThumbnailSource.cs" />
    <Reference Include="FFXIVClientStructs"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/FFXIVClientStructs.dll</HintPath></Reference>
    <Reference Include="InteropGenerator.Runtime"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/InteropGenerator.Runtime.dll</HintPath></Reference>
    <Reference Include="Dalamud"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.dll</HintPath></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.Bindings.ImGui.dll</HintPath></Reference>
  </ItemGroup>
</Project>
