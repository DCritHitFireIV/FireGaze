<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitPixelReadback.cs')">$(DefineConstants);HAS_PIXEL_READBACK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitPixelReadback.cs')">
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPixelReadback.cs" Link="PortraitPixelReadback.cs" />
  </ItemGroup>
</Project>
