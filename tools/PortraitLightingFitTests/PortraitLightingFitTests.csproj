<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitLightingFit.cs')">$(DefineConstants);HAS_LIGHTING_FIT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitToneTarget.cs" Link="PortraitToneTarget.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitLightingFit.cs" Link="PortraitLightingFit.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitLightingFit.cs')" />
  </ItemGroup>
</Project>
