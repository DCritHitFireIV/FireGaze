<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitPixelReadbackD3D11.cs')">$(DefineConstants);HAS_NATIVE_READBACK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPixelReadback.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPixelReadbackDrawBackend.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPixelReadbackD3D11.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitPixelReadbackD3D11.cs')" />
    <Reference Include="Dalamud"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.dll</HintPath></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.Bindings.ImGui.dll</HintPath></Reference>
  </ItemGroup>
</Project>
