<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DALAMUD_HOME Condition="'$(DALAMUD_HOME)' == ''">$(APPDATA)/XIVLauncherCN/addon/Hooks/dev</DALAMUD_HOME>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/Configuration.cs" Link="Configuration.cs" />
    <Compile Include="../../src/FireGaze/LocalPreview/LocalPreviewPreferences*.cs" Link="LocalPreviewPreferences.cs" />
    <Compile Include="../../src/FireGaze.LocalPreview/Interaction/EmoteChatLink.cs" Link="EmoteChatLink.cs" />
    <Compile Include="../../src/FireGaze.LocalPreview/Interaction/NativeEmoteLinkBuilder.cs" Link="NativeEmoteLinkBuilder.cs" />
    <Reference Include="Dalamud"><HintPath>$(DALAMUD_HOME)/Dalamud.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(DALAMUD_HOME)/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="Lumina"><HintPath>$(DALAMUD_HOME)/Lumina.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.ObjectPool"><HintPath>$(DALAMUD_HOME)/Microsoft.Extensions.ObjectPool.dll</HintPath></Reference>
  </ItemGroup>
</Project>
