<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitCaptureSoftwareCompositor.cs')">$(DefineConstants);HAS_SOFTWARE_COMPOSITOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitCaptureSoftwareCompositor.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitCaptureSoftwareCompositor.cs')" Link="Production/PortraitCaptureSoftwareCompositor.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitCaptureModels.cs" Link="Production/PortraitCaptureModels.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitCaptureGeometry.cs" Link="Production/PortraitCaptureGeometry.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPreviewSession.cs" Link="Production/PortraitPreviewSession.cs" />
    <Reference Include="Dalamud"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.dll</HintPath></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.Bindings.ImGui.dll</HintPath></Reference>
  </ItemGroup>
</Project>
