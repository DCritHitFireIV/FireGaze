<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitNativePhaseObservation.ResourceIngress.cs')">$(DefineConstants);RESOURCE_INGRESS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PortraitNativeTestFixtures/FrozenSdkFixture.cs" Link="Fixtures/FrozenSdkFixture.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitNativePhaseHost*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitNativePhaseObservation*.cs" Link="Production/%(Filename)%(Extension)" />
    <ProjectReference Include="../PortraitNativePhaseHostTests/CollectibleProbe/CollectibleProbe.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="Dalamud"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.dll</HintPath></Reference>
    <Reference Include="FFXIVClientStructs"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/FFXIVClientStructs.dll</HintPath></Reference>
    <Reference Include="InteropGenerator.Runtime"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/InteropGenerator.Runtime.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="CopyProbe" AfterTargets="Build">
    <Copy SourceFiles="../PortraitNativePhaseHostTests/CollectibleProbe/bin/$(Configuration)/net10.0-windows/PortraitPhaseCollectibleProbe.dll" DestinationFolder="$(OutputPath)Probe" />
  </Target>
</Project>
