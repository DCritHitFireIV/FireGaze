    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitEditorState.cs" Link="PortraitEditorState.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPreviewSession.cs" Link="PortraitPreviewSession.cs" />
    <Reference Include="Dalamud"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.dll</HintPath></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.Bindings.ImGui.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitStorageBudget.cs" Link="PortraitStorageBudget.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitHistoryPhotoPresentation.cs" Link="PortraitHistoryPhotoPresentation.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPhotoReclaimPolicy.cs" Link="PortraitPhotoReclaimPolicy.cs" />
  </ItemGroup>
</Project>
