<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><NoWarn>$(NoWarn);CA1416</NoWarn>
    <PhotoServiceSource Condition="'$(PhotoServiceSource)' == ''">../../src/FireGaze/PortraitPreview/PortraitPhotoService.cs</PhotoServiceSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPhotoTrace.cs" Link="PortraitPhotoTrace.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitCaptureRetirement.cs" Link="PortraitCaptureRetirement.cs" />
    <Compile Include="$(PhotoServiceSource)" Link="PortraitPhotoService.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitFavoritePhotos.cs" Link="PortraitFavoritePhotos.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitCaptureSoftwareCompositor.cs" Link="PortraitCaptureSoftwareCompositor.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitCaptureModels.cs" Link="PortraitCaptureModels.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitCaptureGeometry.cs" Link="PortraitCaptureGeometry.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitThumbnailCache.cs" Link="PortraitThumbnailCache.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitThumbnailCaptureGate.cs" Link="PortraitThumbnailCaptureGate.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitThumbnailTextureCache.cs" Link="PortraitThumbnailTextureCache.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitThumbnailImage.cs" Link="PortraitThumbnailImage.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitHistoryStore.cs" Link="PortraitHistoryStore.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitHistoryWriter.cs" Link="PortraitHistoryWriter.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitManagedDrain.cs" Link="PortraitManagedDrain.cs" />
