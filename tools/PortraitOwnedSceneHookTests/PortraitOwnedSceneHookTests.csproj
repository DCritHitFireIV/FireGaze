<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitOwnedSceneHooks.cs')">$(DefineConstants);HAS_OWNED_HOOKS</DefineConstants>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitOwnedSceneJointPlan.cs')">$(DefineConstants);HAS_OWNED_JOINT_PLAN</DefineConstants>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitOwnedSceneJointHost.cs')">$(DefineConstants);HAS_OWNED_JOINT_HOST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneExperimentBroker.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneHookPhaseContract.cs" Link="Production/PortraitOwnedSceneHookPhaseContract.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneContextContract.cs" Link="Production/PortraitOwnedSceneContextContract.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneSlotReader.cs" Link="Production/PortraitOwnedSceneSlotReader.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneSlotCensus.cs" Link="Production/PortraitOwnedSceneSlotCensus.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitContextInterception.cs" Link="Production/PortraitContextInterception.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPreviewSession.cs" Link="PortraitPreviewSession.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneLeaseContract.cs" Link="PortraitOwnedSceneLeaseContract.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneHooks*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneControllerBroker.cs" Link="Production/PortraitOwnedSceneControllerBroker.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneJointPlan.cs" Link="Production/PortraitOwnedSceneJointPlan.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitOwnedSceneJointPlan.cs')" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneJointHost*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedCharaView*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitEditorState.cs" Link="Production/PortraitEditorState.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitNativePhaseHost*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitNativePhaseObservation*.cs" Link="Production/%(Filename)%(Extension)" />
    <Reference Include="FFXIVClientStructs"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/FFXIVClientStructs.dll</HintPath></Reference>
    <Reference Include="InteropGenerator.Runtime"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/InteropGenerator.Runtime.dll</HintPath></Reference>
    <Reference Include="Dalamud"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.dll</HintPath></Reference>
  </ItemGroup>
</Project>
