<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitImageAnalysis.cs')">$(DefineConstants);HAS_IMAGE_ANALYSIS</DefineConstants>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitLightDirection.cs')">$(DefineConstants);HAS_LIGHT_DIRECTION</DefineConstants>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitAnalysisRequest.cs')">$(DefineConstants);HAS_ANALYSIS_REQUEST</DefineConstants>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitToneTarget.cs')">$(DefineConstants);HAS_TONE_TARGET</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitImageAnalysis.cs" Link="PortraitImageAnalysis.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitImageAnalysis.cs')" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitLightDirection.cs" Link="PortraitLightDirection.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitLightDirection.cs')" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitAnalysisRequest.cs" Link="PortraitAnalysisRequest.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitAnalysisRequest.cs')" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitToneTarget.cs" Link="PortraitToneTarget.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitToneTarget.cs')" />
  </ItemGroup>
</Project>
