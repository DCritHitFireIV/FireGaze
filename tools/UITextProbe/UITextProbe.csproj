<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UITextProbe</AssemblyName>
    <RootNamespace>FireGaze.UIText.Probe</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

  <!-- 抽取器只有一份实现：插件里那份，这里直接源码编译进来，保证探针和插件行为一致 -->
  <ItemGroup>
    <Compile Include="..\..\src\FireGaze\UiText\*.cs" LinkBase="UIText" />
  </ItemGroup>

</Project>
