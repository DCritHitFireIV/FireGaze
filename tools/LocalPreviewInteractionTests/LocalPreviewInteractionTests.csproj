    <Compile Include="../../src/FireGaze.LocalPreview/Interaction/ChatItemMenuResolver.cs" Link="ChatItemMenuResolver.cs" />
    <Compile Include="../../src/FireGaze.LocalPreview/Interaction/MarketItemMenuResolver.cs" Link="MarketItemMenuResolver.cs" />
    <Compile Include="../../src/FireGaze.LocalPreview/Interaction/NativeEmoteLinkBuilder.cs" Link="NativeEmoteLinkBuilder.cs" />
    <Compile Include="../../src/FireGaze.LocalPreview/Interaction/EmoteLogTemplateIndex.cs" Link="EmoteLogTemplateIndex.cs" />
    <Compile Include="../../src/FireGaze.LocalPreview/Interaction/NativeEmoteQueueBindings.cs" Link="NativeEmoteQueueBindings.cs" />
    <Reference Include="Lumina"><HintPath>$(DALAMUD_HOME)/Lumina.dll</HintPath></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(DALAMUD_HOME)/Lumina.Excel.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.ObjectPool"><HintPath>$(DALAMUD_HOME)/Microsoft.Extensions.ObjectPool.dll</HintPath></Reference>
  </ItemGroup>
</Project>
