<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitOwnedSceneSlotReader.cs')">$(DefineConstants);OWNED_SLOT</DefineConstants>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitOwnedSceneSlotCensus.cs')">$(DefineConstants);SLOT_CENSUS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitContextInterception.cs" Link="PortraitContextInterception.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitOwnedSceneSlot*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPreviewSession.cs" Link="PortraitPreviewSession.cs" />
    <Reference Include="FFXIVClientStructs"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/FFXIVClientStructs.dll</HintPath></Reference>
    <Reference Include="InteropGenerator.Runtime"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/InteropGenerator.Runtime.dll</HintPath></Reference>
  </ItemGroup>
</Project>
