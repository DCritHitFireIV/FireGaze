<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequireHmsCompatRoot" BeforeTargets="BeforeBuild" Condition="'$(HmsCompatRoot)' == ''">
    <Error Text="Pass -p:HmsCompatRoot=the isolated HMS compatibility checkout." />
  </Target>
  <ItemGroup>
    <Compile Include="../../src/FireGaze.LocalPreview/Runtime/CaptureProjection.cs" Link="CaptureProjection.cs" />
    <Compile Include="$(HmsCompatRoot)/Services/LocalPreviewProjection.cs" Link="LocalPreviewProjection.cs" />
    <Compile Include="$(HmsCompatRoot)/Services/LocomotionData.cs" Link="LocomotionData.cs" />
  </ItemGroup>
</Project>
