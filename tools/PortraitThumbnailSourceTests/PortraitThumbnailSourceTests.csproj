<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitThumbnailSource.cs')">$(DefineConstants);HAS_SOURCE</DefineConstants>
    <DefineConstants Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitPhotoTrace.cs')">$(DefineConstants);HAS_PHOTO_TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitCaptureRetirement.cs" Link="PortraitCaptureRetirement.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPhotoTrace.cs" Link="PortraitPhotoTrace.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitPhotoTrace.cs')" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitPreviewSession.cs" Link="PortraitPreviewSession.cs" />
    <Compile Include="../../src/FireGaze/PortraitPreview/PortraitThumbnailSource.cs" Link="PortraitThumbnailSource.cs" Condition="Exists('../../src/FireGaze/PortraitPreview/PortraitThumbnailSource.cs')" />
    <Reference Include="FFXIVClientStructs"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/FFXIVClientStructs.dll</HintPath></Reference>
    <Reference Include="InteropGenerator.Runtime"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/InteropGenerator.Runtime.dll</HintPath></Reference>
    <Reference Include="Dalamud"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.dll</HintPath></Reference>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(APPDATA)/XIVLauncherCN/addon/Hooks/dev/Dalamud.Bindings.ImGui.dll</HintPath></Reference>
  </ItemGroup>
</Project>
