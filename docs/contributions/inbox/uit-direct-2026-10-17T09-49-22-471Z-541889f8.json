      "Context": "UI.Settings",
      "Source": "ai:deepseek",
      "PreserveID": true,
      "Role": "UI",
      "RoleReason": "→ ImGui.Checkbox"
    },
    {
      "Original": "Allows emergency movement via holding down MB1 and MB2 simultaneously.",
      "Translated": "允许同时按住鼠标左键和右键进行紧急移动。",
      "Context": "UI.Settings",
      "Source": "ai:deepseek",
      "Role": "UI",
