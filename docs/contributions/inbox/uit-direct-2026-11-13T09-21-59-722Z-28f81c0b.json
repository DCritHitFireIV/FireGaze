    },
    {
      "Original": "Sonar Lodestone Verification",
      "Translated": "声呐磁石验证",
      "Context": "[SonarPlugin] LodestoneVerifyWindow..ctor",
      "Source": "ai:public-caiyun",
      "PreserveID": true,
      "Role": "UI",
      "RoleReason": "→ 窗口标题"
    },
    {
      "Original": "Lodestone Verification is needed for your currently logged in character:",
      "Translated": "您当前登录的角色需要进行Lodestone验证：",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.Draw",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "You can suppress this dialog at /sonarconfig General tab, Lodestone Settings.",
      "Translated": "您可以在/sonarconfig的“常规”选项卡中的“Lodestone设置”中禁用此对话框。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.Draw",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Unspecified Reason.",
      "Translated": "未说明原因。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Please contact Sonar support for assistance.",
      "Translated": "请联系 Sonar 支持团队寻求帮助。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Your character is currently not verified.",
      "Translated": "您的角色目前未通过验证。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Your character lodestone profile is not found.",
      "Translated": "未找到您的角色Lodestone个人资料。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Make your character's Lodestone profile searchable and public. You can set it back to private after verification is done.",
      "Translated": "将您的角色Lodestone个人资料设置为可搜索和公开。验证完成后，您可以将其重新设置为私密。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Your character lodestone profile is private.",
      "Translated": "您的角色Lodestone个人资料为私密。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Make your Lodestone profile public to be able to verify. You can set it back to private after verification is done.",
      "Translated": "请将您的Lodestone个人资料设为公开，以便进行验证。验证完成后，您可以将其重新设置为私密。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Your character has been renamed and your character's lodestone profile is private.",
      "Translated": "您的角色已重命名，且您的角色Lodestone个人资料已设为私密。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Your character hash mismatch and your character's lodestone profile is private.",
      "Translated": "您的角色哈希值不匹配，且您的角色磁石档案为私密状态。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Your character lodestone information stored at Sonar is stale.",
      "Translated": "您存储在Sonar的角色Lodestone信息已过期。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Unable to provide reason.",
      "Translated": "无法提供原因。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Update your Sonar plugin or contact support for assistance.",
      "Translated": "请更新您的 Sonar 插件，或联系支持团队以寻求帮助。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Add the following code into your chracter's lodestone profile bio:",
      "Translated": "将以下代码添加到您角色的Lodestone个人资料简介中：",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Copy",
      "Translated": "复制",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "PreserveID": true,
      "Role": "UI",
      "RoleReason": "包含可翻译的独立显示位置；功能或未证明的位置保持原文，写入时逐位置核对"
    },
    {
      "Original": "Open Lodestone Profile",
      "Translated": "打开 Lodestone 个人资料",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawReason",
      "Source": "ai:public-caiyun",
      "PreserveID": true,
      "Role": "UI",
      "RoleReason": "→ ImGui.Button"
    },
    {
      "Original": "This verification is a requirement.",
      "Translated": "此验证是必选项。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawVerification",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "This verification will become a requirement in ",
      "Translated": "此验证将在以下时间成为一项要求：",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawVerification",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": " days.",
      "Translated": "天。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawVerification",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": " hours.",
      "Translated": "小时。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawVerification",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": " minutes.",
      "Translated": "分钟。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawVerification",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "This verification will become a requirement in less than 5 minutes.",
      "Translated": "此验证将在不到 5 分钟后成为一项要求。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawVerification",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "This verification is not a requirement at this time.",
      "Translated": "目前无需进行此项验证。",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawVerification",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Verify",
      "Translated": "验证",
      "Context": "[SonarPlugin] LodestoneVerifyWindow.DrawVerification",
      "Source": "ai:public-caiyun",
