    {
      "Original": "Open A Realm Reorganized.",
      "Translated": "打开重组的领域。",
      "Context": "Plugin..ctor",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ CommandInfo.HelpMessage"
    },
    {
      "Original": "Tidy up your glam collection! Scans your Glamour Dresser for items that can be moved to the Armoire, detects sets that can be regrouped, and helps you free inventory/retainers/chocobo space.",
      "Translated": "整理你的迷人收藏！扫描您的魅力梳妆台中是否有可以移动到衣橱的物品，检测可以重新组合的物品，并帮助您释放库存/固定器/陆行鸟空间。",
      "Context": "MainWindow.Draw",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "Press Scan to populate results.",
      "Translated": "按“扫描”填充结果。",
      "Context": "MainWindow.DrawBody",
      "Source": "ai:public-caiyun",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped"
    },
    {
      "Original": "♥ Support on Ko-fi",
      "Translated": "♥ 支持 Ko-fi",
      "Context": "MainWindow.DrawFooter",
      "Source": "ai:public-caiyun",
      "PreserveID": true,
      "Role": "UI",
      "RoleReason": "→ ImGui.SmallButton"
    },
