<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <AssemblyName>FireGaze</AssemblyName>
    <Name>FireGaze</Name>
    <Version>1.0.0.21</Version>
    <Authors>fire</Authors>
    <Author>fire</Author>
    <IconUrl>https://raw.githubusercontent.com/DCritHitFireIV/FireGaze/main/Resources/icon.png?v=2</IconUrl>
    <Punchline>提供对第三方插件简介汉化等功能</Punchline>
    <Description>第三方插件简介汉化
第三方插件仓库坏链检测
浏览插件仓库阻止列表被自动重载顶回顶部（已知问题：拦截可能不生效，见插件内「插件安装器」页说明）

Localization of third-party plugin descriptions; dead-link detection for third-party plugin repositories; keeping the installer list from being rebuilt out from under you while browsing (known issue: the blocking may not always take effect - see the "Plugin Installer" tab in the plugin).</Description>
    <PackageProjectUrl>https://github.com/DCritHitFireIV/FireGaze</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DCritHitFireIV/FireGaze</RepositoryUrl>
    <!-- 固定插件清单里的 API 级别（避免 CI 用新版 Dalamud 构建时把级别写高） -->
    <DalamudApiLevel>15</DalamudApiLevel>
    <!-- 国服（XIVLauncherCN）用 build.cmd 设置 DALAMUD_HOME；国际服走 SDK 默认路径 -->
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)\</DalamudLibPath>
  </PropertyGroup>

  <!-- 词表跟随插件一起打包（发布 zip 里会有 translations.json） -->
  <ItemGroup>
    <None Include="..\..\translations.json" Link="translations.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    0Harmony 不参与编译、也不放在插件根目录：
      · 放根目录会被卫月当作「私有依赖」加载进插件的 collectible / in-memory ALC，
        Harmony 建内部动态程序集时会报 FileLoadException 0x80131515（实测踩过）；
      · 放到 libs/ 后在插件启动时自行 AssemblyLoadContext.Default.LoadFromAssemblyPath()，
        与 ProxyPlugin 的做法一致。
  -->
  <Target Name="CopyHarmonyToLibs" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\deps\0Harmony.dll"
          DestinationFolder="$(OutDir)libs"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
