<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <AssemblyName>FireGaze</AssemblyName>
    <Name>FireGaze</Name>
    <Version>1.3.0.30</Version>
    <Authors>fire</Authors>
    <Author>fire</Author>
    <IconUrl>https://raw.githubusercontent.com/DCritHitFireIV/FireGaze/main/Resources/icon.png?v=2</IconUrl>
    <Punchline>提供对第三方插件汉化等功能</Punchline>
    <Description>第三方插件汉化
插件安装器仓库简介汉化
第三方插件仓库坏链检测
拦截插件安装器自动刷新

Localization of third-party plugin descriptions; dead-link detection for third-party plugin repositories; keeping the plugin installer list from being reset by automatic refreshes.</Description>
    <Tags>repository;translation;ui</Tags>
    <CategoryTags>utility</CategoryTags>
    <PackageProjectUrl>https://github.com/DCritHitFireIV/FireGaze</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DCritHitFireIV/FireGaze</RepositoryUrl>
    <!-- 固定插件清单里的 API 级别（避免 CI 用新版 Dalamud 构建时把级别写高） -->
    <DalamudApiLevel>15</DalamudApiLevel>
    <!-- 国服（XIVLauncherCN）用 build.cmd 设置 DALAMUD_HOME；国际服走 SDK 默认路径 -->
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)\</DalamudLibPath>
  </PropertyGroup>

  <!-- 离线冒烟测试（fgtest）要能调到 internal 类型：推送客户端、贡献存储等 -->
  <ItemGroup>
    <InternalsVisibleTo Include="fgtest" />
  </ItemGroup>

  <!-- 词表与术语表跟随插件一起打包（发布 zip 里会有 translations.json / ffxiv-glossary.tsv） -->
  <ItemGroup>
    <None Include="..\..\translations.json" Link="translations.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ffxiv-glossary.tsv" Link="ffxiv-glossary.tsv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\uit-rules.json" Link="uit-rules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- AtmoOmen 生态的代码规范分析器（DR0001/0002/0008/0009，MIT）：与 DailyRoutines / UntarnishedHeart / OmenTools 同一套 -->
  <ItemGroup>
    <PackageReference Include="DailyRoutines.CodeAnalysis" Version="2.6.0" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- 插件内部文本汉化：读 IL 抽字符串、打补丁（MIT）。要随插件一起发到玩家手里，所以不能设 PrivateAssets -->
  <ItemGroup>
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

</Project>
