    {
      "Original": "Welcome to the Configuration Wizard!",
      "Translated": "欢迎使用配置向导！",
      "Context": "ConfigWizardWindow.DrawWelcome",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "This wizard will help you configure new options added since the latest patch. You can skip this setup and modify the settings later.",
