    {
      "Original": "This plugin opens its own window when speaking with a shop vendor and has no UI here.",
      "Context": "LandingWindow.Draw",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ ImGui.TextWrapped",
      "Translated": "与商人交谈时，插件会自行打开窗口。此处没有可操作的界面。",
      "Source": "library"
    },
    {
      "Original": "Open Docs",
      "Context": "LandingWindow.Draw",
      "PreserveID": true,
      "Role": "UI",
      "RoleReason": "→ ImGui.Button",
      "Translated": "打开文档",
      "Source": "library"
    },
    {
