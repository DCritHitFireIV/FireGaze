    {
      "Original": "[Skippy] Your configuration was from an older version and has been reset to defaults. Please re-apply your settings.",
      "Context": "Skippy..ctor",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ IChatGui.Print",
      "Translated": "[Skippy] 旧版本设置已重置为默认值，请重新设置。",
      "Source": "library"
    },
    {
      "Original": "[Skippy] Auto-Party: Queue popped without a premade party of 4 — cutscenes will not be skipped on this run.",
      "Context": "Skippy.OnCfPop",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ IChatGui.Print",
      "Translated": "[Skippy] 自动组队：匹配成功时未检测到 4 人预组小队，本轮不会跳过过场动画。",
      "Source": "library"
    },
    {
      "Original": "[Skippy] Auto-Party: Entered MSQ Instance with a Premade Light Party - MSQ Roulette Skip will be active.",
      "Context": "Skippy.OnTerritoryChanged",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ IChatGui.Print",
      "Translated": "[Skippy] 自动组队：已与四人预组小队进入主线副本，本轮将启用主线随机任务过场跳过。",
      "Source": "library"
    },
    {
      "Original": "[Skippy] Auto-Party: Entered MSQ Instance — Waiting for the Party Plugin Check to complete...",
      "Context": "Skippy.OnTerritoryChanged",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ IChatGui.Print",
      "Translated": "[Skippy] 自动组队：已进入主线副本，正在等待队员插件检查完成……",
      "Source": "library"
    },
    {
      "Original": "[Skippy] Auto-Party: Left MSQ Instance - MSQ Roulette Skip is back to being disabled.",
