    },
    {
      "Original": "(custom center active)",
      "Context": "ConfigWindow.Draw",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextColored",
      "Translated": "（已使用自定义中心）",
      "Source": "library"
    },
    {
      "Original": "(using default 100, 100)",
      "Context": "ConfigWindow.Draw",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextColored",
      "Translated": "（使用默认坐标 100, 100）",
      "Source": "library"
    },
    {
      "Original": "Auto-place at center",
      "Context": "ConfigWindow.Draw",
      "PreserveID": true,
      "Role": "UI",
      "RoleReason": "→ ImGui.Checkbox",
      "Translated": "自动移至场地中央",
