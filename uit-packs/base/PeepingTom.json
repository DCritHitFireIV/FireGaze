  "entries": [
    {
      "Original": "Alias for /ppeepingtom",
      "Context": "Plugin..ctor",
      "Role": "UI",
      "RoleReason": "→ CommandInfo.HelpMessage",
      "Translated": "/ppeepingtom 的别名",
      "Source": "library"
    },
    {
      "Original": "Use with no arguments to show the list. Use with \"c\" or \"config\" to show the config",
      "Context": "Plugin..ctor",
      "Role": "UI",
      "RoleReason": "→ CommandInfo.HelpMessage",
      "Translated": "不加参数可显示列表，使用 c 或 config 可打开设置。",
      "Source": "library"
    }
  ],
