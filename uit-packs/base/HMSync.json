    {
      "Original": "Open the HMapSync window.",
      "Context": "HMSyncPlugin..ctor",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ CommandInfo.HelpMessage",
      "Translated": "打开 HMapSync 窗口。",
      "Source": "library"
    },
    {
      "Original": "[HMSync] Lost protection on a virtual map. Returning you to safety and ending the session.",
      "Context": "HMSyncPlugin.OnFrameworkUpdate",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ IChatGui.PrintError",
      "Translated": "[HMSync] 虚拟地图保护已失效。正在将你送回安全位置并结束会话。",
      "Source": "library"
    },
    {
      "Original": "[HMSync] Not in a session. Use /hms start or /hms join <code> first.",
      "Context": "HMSyncPlugin.OnCommand",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ IChatGui.Print",
      "Translated": "[HMSync] 尚未加入会话。请先使用 /hms start 或 /hms join <code>。",
      "Source": "library"
    },
    {
      "Original": "[HMSync] usage: /hms firecut <cutsceneRowId>",
      "Context": "HMSyncPlugin.OnCommand",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ IChatGui.Print",
      "Translated": "[HMSync] 用法：/hms firecut <cutsceneRowId>",
      "Source": "library"
    },
    {
      "Original": "[HMSync] /hms cutprobe is a debug command. Enable debug mode in Config to use it.",
      "Context": "HMSyncPlugin.OnCommand",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ IChatGui.Print",
      "Translated": "[HMSync] /hms cutprobe 是调试命令，需要先在设置中启用调试模式。",
      "Source": "library"
    },
    {
      "Original": " match(es) logged - search [SCENEPROBE] in /xllog.",
      "Context": "HMSyncPlugin.OnCommand",
      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ IChatGui.Print",
      "Translated": " 个匹配项已记录。请在 /xllog 中搜索 [SCENEPROBE]。",
      "Source": "library"
    },
    {
      "Original": " is a debug command. Enable debug mode in Config to use it.",
