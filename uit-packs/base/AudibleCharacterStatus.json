    {
      "Original": "Allows the sound from this plugin to play when the game is in the background.",
      "Context": "PluginConfiguriation.Draw",
      "Role": "UI",
      "RoleReason": "→ ImGui.Text",
      "Translated": "允许游戏在后台时播放本插件的提示音。",
      "Source": "library"
    },
    {
      "Original": "Enable Sound Outside of Combat",
      "Context": "PluginConfiguriation.Draw",
      "PreserveID": true,
      "Role": "UI",
      "RoleReason": "→ ImGui.Checkbox",
      "Translated": "脱战时也播放提示音",
      "Source": "library"
    },
    {
      "Original": "Enable to make sounds play even while not in combat.",
      "Context": "PluginConfiguriation.Draw",
      "Role": "UI",
      "RoleReason": "→ ImGui.Text",
      "Translated": "启用后，非战斗状态也会播放提示音。",
      "Source": "library"
    },
    {
      "Original": "File is not supported. Use MP3, WAV, or OGG.",
      "Context": "PluginConfiguriation.FindSoundMessage",
      "Role": "UI",
      "RoleReason": "→ ImGui.TextColored",
      "Translated": "不支持此文件格式。请选择 MP3、WAV 或 OGG 文件。",
      "Source": "library"
    },
    {
