      "Original": "Welcome to XIVCombo Expanded v",
      "Context": "OneTimeModal.Draw",
      "Role": "UI",
      "RoleReason": "→ ImGui.Text",
      "Translated": "欢迎使用 XIVCombo Expanded v",
      "Source": "library"
    },
