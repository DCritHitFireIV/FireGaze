      "Key": "Settings_CountdownTab_CountdownWindowCentered",
      "Translated": "将倒计时窗口居中",
      "Source": "library"
    },
    {
      "Original": "Don't overlap with game countdown (default)",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_DefaultOriginalCountDown",
      "Translated": "避开游戏原生倒计时（默认）",
      "Source": "library"
    },
