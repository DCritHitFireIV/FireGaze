    },
    {
      "Original": "Display threshold",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_CountdownDisplayThreshold",
      "Translated": "显示阈值",
      "Source": "library"
    },
    {
      "Original": "This setting determines at what point during the countdown the timer will become visible. For example, if the value is set to 7, the countdown timer will not be shown until 7 seconds have passed, and will then be displayed until the end of the countdown.",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_CountdownDisplayThreshold_Help",
      "Translated": "设置倒计时开始后多久显示计时器。例如设为 7 时，倒计时开始 7 秒后才会显示计时器，并持续显示到倒计时结束。",
      "Source": "library"
    },
    {
      "Original": "Scale",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_CountdownScale",
      "Translated": "缩放",
      "Source": "library"
    },
    {
