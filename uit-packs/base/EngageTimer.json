    },
    {
      "Original": "Scale",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_FloatingWindowScale",
      "Translated": "缩放",
      "Source": "library"
    },
    {
      "Original": "Hide original countdown",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_HideOriginalCountDown",
      "Translated": "隐藏原生倒计时",
      "Source": "library"
    },
    {
      "Original": "Also replace numbers before 5",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_HideOriginalCountDown_Help",
      "Translated": "一并替换倒计时 5 秒前的数字",
      "Source": "library"
    },
    {
      "Original": "Draw even if original countdown is visible",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_IgnoreOriginalCountDown",
      "Translated": "游戏原生倒计时可见时仍显示",
      "Source": "library"
    },
    {
      "Original": "Allows you to have the vanilla countdown showing on your game but still use the custom one in a corner or overlaping if you like chaos. Useful if you setup your OBS to not capture addons and want to look unmodified.",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_IgnoreOriginalCountDown_Help",
      "Translated": "保留游戏原有倒计时，同时在角落或原位置叠加自定义倒计时。若已将 OBS 设置为不捕获插件界面，观众仍可看到原版倒计时。",
      "Source": "library"
    },
    {
      "Original": "The \"big countdown\" feature adds the missing numbers to the in-game timer !",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_Info1",
      "Translated": "“大号倒计时”会补齐游戏倒计时中原本省略的数字。",
      "Source": "library"
    },
    {
      "Original": "Fixed width",
      "Container": "EngageTimer.Properties.Strings.resources",
      "Key": "Settings_CountdownTab_Monospaced",
      "Translated": "固定宽度",
      "Source": "library"
    },
    {
      "Original": "When using the multi monitor windows option, positioning the countdown outside of the game (even a little bit) will create a background. As rendering transparent windows is impossible outside of the game, this cannot be fixed for now. Please use the border as a guide.",
      "Container": "EngageTimer.Properties.Strings.resources",
