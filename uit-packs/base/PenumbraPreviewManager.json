    {
      "Original": "Hide option previews from Penumbra File Redirections",
      "Context": "ConfigWindow.Draw",
      "PreserveID": true,
      "Role": "UI",
      "RoleReason": "→ ImGui.Checkbox",
      "Translated": "在 Penumbra 文件重定向列表中隐藏选项预览",
