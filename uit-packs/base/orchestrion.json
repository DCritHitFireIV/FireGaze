      "PreserveID": false,
      "Role": "UI",
      "RoleReason": "→ CommandInfo.HelpMessage",
      "Translated": "打开管弦乐琴窗口，以查看、更改或停止游戏背景音乐。完整命令说明见 /porch help。",
      "Source": "library"
    },
