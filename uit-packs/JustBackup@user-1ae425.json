  "entries": [
    {
      "Original": "JustBackup configuration",
      "Translated": "JustBackup 设置",
      "Context": "ConfigWindow..ctor",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Custom backup path (by default: %localappdata%\\JustBackup):",
      "Translated": "自定义备份路径（默认：%localappdata%\\JustBackup）：",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Custom temporary files path (by default: %temp%):",
      "Translated": "自定义临时文件路径（默认：%temp%）：",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Automatically remove old backups",
      "Translated": "自动删除旧备份",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Delete backups older than, days",
      "Translated": "删除早于以下天数的备份",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Delete to recycle bin, if available.",
      "Translated": "删除到回收站（如可用）。",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Always keep at least this number of backup regardless of their date",
      "Translated": "无论日期如何，始终保留至少此数量的备份",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Include plugin configurations",
      "Translated": "包含插件配置",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Include ALL files inside FFXIV's data folder into backup",
      "Translated": "将 FFXIV 数据文件夹内的所有文件包含到备份中",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "  (otherwise only config files will be saved, screenshots, logs, etc will be skipped)",
      "Translated": "（否则仅保存配置文件，截图、日志等将被跳过）",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Exclude replays from backup",
      "Translated": "从备份中排除回放",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Use built-in zip method instead of 7-zip",
      "Translated": "使用内置 zip 方法代替 7-zip",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "7-zip archives are taking up to 15 times less space!",
      "Translated": "7-zip 压缩包占用空间最多可减少 15 倍！",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Do not restrict amount of resources 7-zip can use",
      "Translated": "不限制 7-zip 可使用的资源量",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Minimal interval between backups, minutes",
      "Translated": "备份之间的最小间隔（分钟）",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Backup will not be created if previous backup was created less than this amount of minutes. Note that only successfully completed backups will update interval.",
      "Translated": "如果上次备份创建时间少于该分钟数，则不会创建新备份。注意只有成功完成的备份才会更新间隔。",
      "Context": "ConfigWindow.Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Open backup folder",
      "Translated": "打开备份文件夹",
      "Context": "ConfigWindow.Tools",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Open FFXIV configuration folder",
      "Translated": "打开 FFXIV 配置文件夹",
      "Context": "ConfigWindow.Tools",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Open plugins configuration folder",
      "Translated": "打开插件配置文件夹",
      "Context": "ConfigWindow.Tools",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Open current character's config directory",
      "Translated": "打开当前角色的配置目录",
      "Context": "ConfigWindow.Tools",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Add identification info",
      "Translated": "添加识别信息",
      "Context": "ConfigWindow.Tools",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Adds an empty file into character's config directory\ncontaining character's name and home world",
      "Translated": "在角色配置目录中添加一个空文件\n包含角色名称和所在服务器",
      "Context": "ConfigWindow.Tools",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Ignored (partial) Path",
      "Translated": "忽略的（部分）路径",
      "Context": "ConfigWindow.Ignored",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Override game configuration folder path:",
      "Translated": "覆盖游戏配置文件夹路径：",
      "Context": "ConfigWindow.Expert",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Maximum threads",
      "Translated": "最大线程数",
      "Context": "ConfigWindow.Expert",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Throttle copying, ms",
      "Translated": "蛇喉复制，毫秒",
      "Context": "ConfigWindow.Expert",
      "Source": "ai:deepseek"
    },
    {
      "Original": "The higher this value, the longer backup creation will take but the less loaded your SSD/HDD will be. Increase this value if you're experiencing lag during backup process.",
      "Translated": "此值越高，备份重现宇宙耗时越长，但 SSD/HDD 负载越低。若备份过程中出现卡顿，请增大此值。",
      "Context": "ConfigWindow.Expert",
      "Source": "ai:deepseek"
    },
    {
      "Original": "default",
      "Translated": "默认",
      "Context": "ConfigWindow.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Settings",
      "Translated": "设置",
      "Context": "ConfigWindow.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Tools",
      "Translated": "工具",
      "Context": "ConfigWindow.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Ignored pathes (beta)",
      "Translated": "忽略的路径（测试版）",
      "Context": "ConfigWindow.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Expert options",
      "Translated": "专家选项",
      "Context": "ConfigWindow.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Configuration saved",
      "Translated": "配置已保存",
      "Context": "ConfigWindow.OnClose",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Added identification info for current character",
      "Translated": "已为当前角色添加识别信息",
      "Context": "ConfigWindow.Tools",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Read how to restore a backup",
      "Translated": "阅读如何恢复备份",
      "Context": "Settings",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Error while adding identification info for current character:\n",
      "Translated": "为当前角色添加识别信息时出错：",
      "Context": "Tools",
      "Source": "ai:deepseek"
    },
    {
      "Original": "do a manual backup",
      "Translated": "执行手动备份",
      "Context": "JustBackup..ctor",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Backup skipped because ",
      "Translated": "备份已跳过，因为",
      "Context": "JustBackup.DoBackup",
      "Source": "ai:deepseek"
    },
    {
      "Original": " minutes did not passed yet since last backup",
      "Translated": "距上次备份尚未满分钟",
      "Context": "JustBackup.DoBackup",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Backup created successfully!",
      "Translated": "备份创建成功！",
      "Context": "DoBackupInternal",
      "Source": "ai:deepseek"
    },
    {
      "Original": "There were errors while creating backup, please check log",
      "Translated": "创建备份时出错，请检查日志",
      "Context": "DoBackupInternal",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Could not create backup:\n",
      "Translated": "无法创建备份：",
      "Context": "DoBackupInternal",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Error deleting temp files:\n",
      "Translated": "删除临时文件时出错：",
      "Context": "DoBackupInternal",
      "Source": "ai:deepseek"
    },
    {
      "Original": "JustBackup - another instance is already running",
      "Translated": "JustBackup - 另一个实例已在运行",
      "Context": "ModalWindowAskBackup..ctor",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Another backup is already in progress. \nAttempting to create new backup while old \n  is not yet finished may result both backups not being done properly.",
      "Translated": "另一个备份已在进行中。\n在旧备份尚未完成时尝试创建新备份，\n可能导致两个备份都无法正常完成。",
      "Context": "ModalWindowAskBackup.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Force stop old backup and create new backup",
      "Translated": "强制停止旧备份并创建新备份",
      "Context": "ModalWindowAskBackup.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Could not terminate old backup",
      "Translated": "无法终结旧备份",
      "Context": "ModalWindowAskBackup.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Don't start new backup and let old backup finish",
      "Translated": "不启动新备份，让旧备份完成",
      "Context": "ModalWindowAskBackup.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "(not recommended) Run new backup anyway",
      "Translated": "（不推荐）仍然运行新备份",
      "Context": "ModalWindowAskBackup.Draw",
      "Source": "ai:deepseek"
    }
  ],
