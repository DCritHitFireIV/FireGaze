    {
      "Original": "!! Warning !!\nThis cancels your current downloads!",
      "Translated": "!! 警告 !!\n这将取消你当前的下载！",
      "Context": "AcquiryWindow.DrawRefresh",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "This helps if you get repeated errors when acquiring data.",
      "Translated": "如果你在获取数据时反复遇到错误，这会有帮助。",
