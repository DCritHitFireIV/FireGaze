    {
      "Original": "Sonar Lodestone Verification",
      "Translated": "Sonar 石之家验证",
      "Context": "LodestoneVerifyWindow..ctor",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Lodestone Verification is needed for your currently logged in character:",
      "Translated": "当前登录的角色需要进行石之家验证：",
      "Context": "LodestoneVerifyWindow.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "You can suppress this dialog at /sonarconfig General tab, Lodestone Settings.",
      "Translated": "你可以在 /sonarconfig 的常规标签页、石之家设置中关闭此对话框。",
      "Context": "LodestoneVerifyWindow.Draw",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Unspecified Reason.",
      "Translated": "未指明原因。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Please contact Sonar support for assistance.",
      "Translated": "请联系 Sonar 支持以获取帮助。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Your character is currently not verified.",
      "Translated": "你的角色当前未验证。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Your character lodestone profile is not found.",
      "Translated": "未找到你的角色石之家资料。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Make your character's Lodestone profile searchable and public. You can set it back to private after verification is done.",
      "Translated": "将你的角色石之家资料设为可搜索且公开。验证完成后可以改回私密。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Your character lodestone profile is private.",
      "Translated": "你的角色石之家资料为私密状态。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Make your Lodestone profile public to be able to verify. You can set it back to private after verification is done.",
      "Translated": "将你的石之家资料设为公开以进行验证。验证完成后可以改回私密。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Your character has been renamed and your character's lodestone profile is private.",
      "Translated": "你的角色已改名，且角色石之家资料为私密状态。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Your character hash mismatch and your character's lodestone profile is private.",
      "Translated": "你的角色哈希不匹配，且角色石之家资料为私密状态。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Your character lodestone information stored at Sonar is stale.",
      "Translated": "Sonar 中存储的角色石之家信息已过期。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Unable to provide reason.",
      "Translated": "无法提供原因。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Update your Sonar plugin or contact support for assistance.",
      "Translated": "请更新您的 Sonar 插件或联系支持人员获取帮助。",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Add the following code into your chracter's lodestone profile bio:",
      "Translated": "将以下代码添加到您角色的 Lodestone 个人资料简介中：",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Copy",
      "Translated": "复制",
      "Context": "LodestoneVerifyWindow.DrawReason",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Open Lodestone Profile",
      "Translated": "打开 Lodestone 个人资料",
