  "entries": [
    {
      "Original": "Added a changelog",
      "Translated": "新增更新日志",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Fixed graphical issue when resizing windows on clear blue theme.",
      "Translated": "修复了在纯蓝主题下调整窗口大小时的图形问题。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Now using the Dalamud Window system.\nESC will now close Simple Tweaks windows.",
      "Translated": "现在使用 Dalamud 窗口系统。\nESC 现在会关闭 Simple Tweaks 窗口。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Added command to open the config window to a specific tweak. (/tweaks find [id])",
      "Translated": "新增命令，可将配置窗口打开到指定调整项。(/tweaks find [id])",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Made April Fools Joke Stupid",
      "Translated": "把愚人节玩笑改得更蠢了",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Removed April Fools joke due to potential crash.",
      "Translated": "因可能导致崩溃，移除了愚人节玩笑。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "General fixes for 6.38",
      "Translated": "针对 6.38 的常规修复",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "General fixes for 6.4",
      "Translated": "针对 6.4 的常规修复",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Added an option to opt out of analytics\n\tNote:\n\t\tNo analytics are currently being collected.\n\t\tThis is a preemptive opt out for the future.",
      "Translated": "新增退出数据统计的选项\n\t注意：\n\t\t目前未收集任何统计数据。\n\t\t这是为将来提前提供的退出选项。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Added preview images to some tweaks.",
      "Translated": "为部分调整项新增了预览图。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Tweaks that add commands can now have their commands customized.",
      "Translated": "添加命令的调整项现在可以自定义其命令。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "The tweak list is now split into more categories",
      "Translated": "调整项列表现在划分为更多分类",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Tweaks can be in multiple categories.",
      "Translated": "调整项可以属于多个分类。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Categories can be disabled in settings.",
      "Translated": "可在设置中禁用分类。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "The 'All Tweaks' pseudo-category displays all available tweaks.",
      "Translated": "“全部调整项”伪分类会显示所有可用的调整项。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "The 'Enabled Tweaks' pesudo-category displays only enabled tweaks.",
      "Translated": "“已启用调整项”伪分类仅显示已启用的调整项。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Added optional metrics collection",
      "Translated": "新增可选的指标收集",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Everyone will be given a chance to opt in or our to the collection of a list of enabled tweaks when first accessing the simple tweaks config window.",
      "Translated": "首次打开 Simple Tweaks 配置窗口时，所有人都有机会选择加入或退出已启用调整项列表的收集。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Anyone who preemptivly opted out will not see the notice as they already made the choice.",
      "Translated": "提前选择退出的用户不会看到此提示，因为他们已做出选择。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "No information will be collected until the 'Allow collection' button is pressed.",
      "Translated": "在按下“允许收集”按钮之前，不会收集任何信息。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "The Simple Tweaks config window will now be decorated during various festive periods.",
      "Translated": "Simple Tweaks 配置窗口现在会在各种节日期间进行装饰。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "This can be disabled in the 'General Options' tab.",
      "Translated": "可在“常规选项”标签页中禁用。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "You can also set a permanent decoration to be used all year round.",
      "Translated": "你也可以设置一个全年使用的永久装饰。",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Support for Dawntrail",
      "Translated": "支持 Dawntrail -曦光旅路-",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
      "Original": "Updated more tweaks for Dawntrail",
      "Translated": "为 Dawntrail -曦光旅路- 更新了更多调整项",
      "Context": "Changelog.AddGeneralChangelogs",
      "PreserveID": false,
      "Source": "library"
    },
    {
