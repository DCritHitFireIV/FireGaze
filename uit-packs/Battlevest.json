  "attributes": [
    {
      "Original": "Stop the addon. Always remember to turn it off when it is not in use!",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/StateCommandType::Off",
      "Translated": "停止插件。不使用时请务必关闭！",
      "Source": "library"
    },
    {
      "Original": "Start the addon in Auto mode. When out of combat or when combat starts, switches the target according to the set condition. \r\n Optionally: You can add the target type to the end of the command you want RSR to do. For example: /rotation Auto Big",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/StateCommandType::Auto",
      "Translated": "以自动模式启动插件。脱战或进入战斗时，根据设定条件切换目标。\n 可选：你可以在想让 RSR 执行的命令末尾添加目标类型。例如：/rotation Auto Big",
      "Source": "library"
    },
    {
      "Original": "Start in Target-Only mode. RSR will auto-select targets per normal logic but will not perform any actions.",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/StateCommandType::TargetOnly",
      "Translated": "以仅选目标模式启动。RSR 会按常规逻辑自动选择目标，但不会执行任何动作。",
      "Source": "library"
    },
    {
      "Original": "Start the addon in Manual mode. You need to choose the target manually. This will bypass any engage settings that you have set up and will start attacking immediately once something is targeted.",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/StateCommandType::Manual",
      "Translated": "以手动模式启动插件。你需要手动选择目标。这会绕过你设置的所有接战设置，一旦选定目标就会立即开始攻击。",
      "Source": "library"
    },
    {
      "Original": "This mode is managed by the AutoDuty plugin",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/StateCommandType::AutoDuty",
      "Translated": "此模式由 AutoDuty 插件管理",
      "Source": "library"
    },
    {
      "Original": "This mode is managed by the Henchman plugin, or any other plugin that requires RSR just do rotation and not targetting.",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/StateCommandType::Henched",
      "Translated": "此模式由 Henchman 插件或其他仅需 RSR 执行转向而不选目标的插件管理。",
      "Source": "library"
    },
    {
      "Original": "Open the settings.",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/OtherCommandType::Settings",
      "Translated": "打开设置。",
      "Source": "library"
    },
    {
      "Original": "Open the rotations.",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/OtherCommandType::Rotations",
      "Translated": "打开转向。",
      "Source": "library"
    },
    {
      "Original": "Open the duty rotations.",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/OtherCommandType::DutyRotations",
      "Translated": "打开任务转向。",
      "Source": "library"
    },
    {
      "Original": "Perform the actions.",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/OtherCommandType::DoActions",
      "Translated": "执行动作。",
      "Source": "library"
    },
    {
      "Original": "Toggle the actions.",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/OtherCommandType::ToggleActions",
      "Translated": "切换动作。",
      "Source": "library"
    },
    {
      "Original": "Do the next action.",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/OtherCommandType::NextAction",
      "Translated": "执行下一个动作。",
      "Source": "library"
    },
    {
      "Original": "All targets that are in range for any abilities (Tanks/Autoduty)",
      "Context": "[属性] DescriptionAttribute Battlevest.Services.RSR_IPCSubscriber/TargetHostileType::AllTargetsCanAttack",
      "Translated": "所有处于任意技能范围内的目标（坦克/自动任务）",
      "Source": "library"
    },
    {
