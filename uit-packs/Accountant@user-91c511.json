      "Source": "ai:deepseek"
    },
    {
      "Original": "Used by Leve Allowances header when any player has accrued more than ",
      "Translated": "用于理符限额标题栏，当有玩家已累积超过",
      "Context": "[Accountant] ColorIdExtensions.Description",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Used by the collapsed header to give it a border to improve visibility.",
      "Translated": "用于折叠标题栏，为其添加边框以提高可见性。",
      "Context": "[Accountant] ColorIdExtensions.Description",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Used by all text that is not colored differently.",
      "Translated": "用于所有未使用其他颜色的文本。",
      "Context": "[Accountant] ColorIdExtensions.Description",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Used by all headers that are not colored differently.",
      "Translated": "用于所有未使用其他颜色的标题栏。",
      "Context": "[Accountant] ColorIdExtensions.Description",
      "Source": "ai:deepseek"
    },
    {
      "Original": "Used by disabled retainers or machines.",
      "Translated": "用于已禁用的雇员或机件。",
      "Context": "[Accountant] ColorIdExtensions.Description",
      "Source": "ai:deepseek"
