    {
      "Container": "CharacterPanelRefined.Localization.resources",
      "Key": "Tooltips_Skill_Spell_Speed_DoT_Increase",
      "Original": "DoT damage increases by 0.1% every {PointsPerTier} points.",
      "Translated": "每 {PointsPerTier} 点，持续伤害提高 0.1%。",
      "Source": "library"
    },
    {
      "Container": "CharacterPanelRefined.Localization.resources",
      "Key": "Tooltips_Expected_Heal",
      "Original": "Average HP restored by a 100 potency healing action, including critical hits as well as passive traits such as Maim and Mend.\n\nA normal heal will restore {@Highlight}{NormalValue}{@Clear} HP.\nA critical hit will restore {@Highlight}{CritValue}{@Clear} HP.\n\nHP restored will always vary by ±3%.",
      "Translated": "100 威力治疗技能的平均恢复 HP，包含暴击以及被动特性（如 Maim and Mend）。\n\n普通治疗将恢复 {@Highlight}{NormalValue}{@Clear} HP。\n暴击将恢复 {@Highlight}{CritValue}{@Clear} HP。\n\n恢复的 HP 始终会有 ±3% 的浮动。",
      "Source": "library"
    },
    {
      "Container": "CharacterPanelRefined.Localization.resources",
      "Key": "Config_Window_Use_Game_Language_Tooltip",
      "Original": "Use the internal game language for this plugin if available.\n Currently Available: English, German, French",
      "Translated": "如果可用，为此插件使用游戏内置语言。\n 当前可用：英语、德语、法语",
      "Source": "library"
    },
